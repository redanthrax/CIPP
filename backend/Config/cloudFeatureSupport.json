{
  "$comment": "Features a tenant's Microsoft cloud does not support (redanthrax/CIPP#4). Edit frontend/src/data/cloudFeatureSupport.json and copy it to backend/Config/cloudFeatureSupport.json; backend/Tests/Static/CloudFeatureSupportSync.Tests.ps1 checks both copies and the derived lists. Commercial is never listed: an entry only ever applies to the clouds in its unsupportedClouds.",
  "sources": {
    "teams-configapi": {
      "reason": "Uses the Teams admin ConfigAPI (New-TeamsRequestV2), which has no documented government host and is refused for government tenants.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "security-compliance": {
      "reason": "Uses Security & Compliance PowerShell (New-ExoRequest -Compliance), which is refused for government tenants because its redirect discovery builds commercial host names.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "m365-licensing": {
      "reason": "Uses admin.microsoft.com / licensing.m365.microsoft.com, which have no documented government host and are refused for government tenants.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "mde-connector": {
      "reason": "Turns on the Defender for Endpoint connector through the commercial MDE portal API (Enable-CIPPMDEConnector), which is refused for government tenants.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "mfa-connector": {
      "reason": "Sends the push through the MFA connector (New-CIPPMFAConnectorToken), which is refused for government tenants.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "reports-office": {
      "reason": "Reads reports.office.com, which has no documented government host and is refused for government tenants.",
      "evidence": "redanthrax/CIPP#3 refusal, docs/dev-documentation/cipp-dev-guide/gcchigh-endpoint-audit.md"
    },
    "copilot-usage-reports": {
      "reason": "Microsoft 365 Copilot usage reports are available in the global service only.",
      "evidence": "https://learn.microsoft.com/graph/api/reportroot-getmicrosoft365copilotusageuserdetail?view=graph-rest-beta (national cloud table: global only)"
    },
    "managed-tenants": {
      "reason": "Reads the partner's Microsoft 365 Lighthouse data (tenantRelationships/managedTenants), which is available in the global service only and never lists a government tenant.",
      "evidence": "https://learn.microsoft.com/graph/api/managedtenants-managedtenant-list-tenants?view=graph-rest-beta (global only); live test 2026-11-11: 400 Resource not found for the segment"
    },
    "audit-log-query": {
      "reason": "Creates Purview audit log searches (security/auditLog/queries), which are available in the global service only.",
      "evidence": "https://learn.microsoft.com/graph/api/security-auditcoreroot-list-auditlogqueries?view=graph-rest-beta (global only)"
    }
  },
